# --- Example environment configuration for the Kettu backend ---
# Copy this file to `.env` (which is git-ignored) and fill in real values, or
# export these variables in your shell / deployment platform before starting the app.
# DO NOT commit real secrets.

# Database (PostgreSQL + PostGIS)
DB_URL=jdbc:postgresql://localhost:5433/kettu
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Google OAuth2 client (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT signing. Use a long, random, Base64-friendly value (>= 32 bytes) in production.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRATION_MS=144000000

# Cloudflare R2 object storage (S3-compatible)
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=khorunaliyev-kettu

# Optional: verbose SQL logging for debugging (default INFO). Set to DEBUG/TRACE locally only.
# HIBERNATE_SQL_LOG_LEVEL=DEBUG
# HIBERNATE_BIND_LOG_LEVEL=TRACE
